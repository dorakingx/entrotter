{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entrotter agent recording 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_version",
    "provider",
    "exchanges"
  ],
  "properties": {
    "agent_version": {
      "const": "0.1.0"
    },
    "provider": {
      "type": "object"
    },
    "exchanges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request",
          "response"
        ],
        "properties": {
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agent_version",
              "request_id",
              "observation",
              "proposed_action",
              "preflight",
              "limits",
              "choices"
            ],
            "properties": {
              "agent_version": {
                "const": "0.1.0"
              },
              "request_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "observation": {
                "type": "object",
                "required": [
                  "step",
                  "local_block_number",
                  "native_balance_wei",
                  "tokens",
                  "completed_actions",
                  "actor",
                  "local_chain_id",
                  "local_block_hash",
                  "timestamp"
                ]
              },
              "proposed_action": {
                "type": "object",
                "required": [
                  "to"
                ]
              },
              "preflight": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "return_data"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "success",
                      "rejected"
                    ]
                  },
                  "return_data": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "limits": {
                "type": "object",
                "required": [
                  "remaining_requested_gas",
                  "max_response_bytes"
                ]
              },
              "choices": {
                "type": "object",
                "required": [
                  "execute",
                  "hold"
                ]
              }
            }
          },
          "response": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "choice",
              "reason"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "choice": {
                "enum": [
                  "execute",
                  "hold"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        }
      }
    }
  }
}
