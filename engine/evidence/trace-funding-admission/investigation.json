    {
      "url": "https://github.com/foundry-rs/foundry/blob/cae51ad458f6abb64852b7709eb784352429825d/crates/anvil/src/eth/backend/executor.rs#L415-L421",
      "fact": "Actual execution invokes evm.transact; invalid REVM transactions fail instead of fabricating receipts."
