    },
    {
      "url": "https://github.com/foundry-rs/foundry/blob/cae51ad458f6abb64852b7709eb784352429825d/crates/anvil/src/eth/backend/executor.rs#L625-L660",
      "fact": "Cumulative block gas and transaction caps remain checked; execution errors classify invalid inputs."
